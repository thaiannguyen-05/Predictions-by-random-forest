model history_searching {
    id     String @id @default(uuid()) @db.Uuid
    symbol String
	currentPrice BigInt
    previousClose BigInt
    open          BigInt
    high          BigInt
    low           BigInt
    volume        BigInt
    marketCap     BigInt
    peRatio       Float
    eps           Float
    beta          Float
    yahooPrice    Float

	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt
}

model stock_compare_summary {
    id             String   @id @default(uuid()) @db.Uuid
    recentDays     Int
    totalTickers   Int
    successTickers Int
    failedTickers  Int
    models         Json
    generatedAt    DateTime @default(now()) @db.Timestamptz(6)
    createdAt      DateTime @default(now()) @db.Timestamptz(6)

    @@index([generatedAt(sort: Desc)])
    @@map("stock_compare_summaries")
}
